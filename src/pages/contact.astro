---
import Layout from '../layouts/Layout.astro';


// Enhanced contact data with additional details
const contactDetails = [
  {
    icon: '📍',
    title: 'Registered Office',
    lines: ['3rd Floor Belmont Road, Uxbridge, England, UB8 1HE'],
    link: { 
      href: 'https://maps.app.goo.gl/QEBgeH7WamtzHBXM9', 
      text: 'View on Maps',
      ariaLabel: 'View our location on Google Maps'
    }
  },
  {
    icon: '📧',
    title: 'Email Us',
    lines: ['For inquiries, quotes, and support'],
    link: { 
      href: 'mailto:info@rytonlimited.com', 
      text: 'info@rytonlimited.com',
      ariaLabel: 'Send email to sales department'
    }
  },
  // {
  //   icon: '📞',
  //   title: 'Call Us',
  //   lines: ['Speak with our sales team directly'],
  //   link: { 
  //     href: 'tel:+4402380123456', 
  //     text: '+44 (0)23 8012 3456',
  //     ariaLabel: 'Call our sales team'
  //   }
  // },
  {
    icon: '⏰',
    title: 'Business Hours',
    lines: ['Monday - Friday: 9:00 AM - 5:00 PM', 'Saturday - Sunday: Closed'],
    note: 'We typically respond within 1 business day'
  }
];

const socialLinks = [
  { name: "Facebook", icon: "fa-brands fa-facebook-f", href: "https://facebook.com" },
  { name: "Twitter", icon: "fa-brands fa-twitter", href: "https://twitter.com" },
  { name: "Instagram", icon: "fa-brands fa-instagram", href: "https://instagram.com" },
  { name: "LinkedIn", icon: "fa-brands fa-linkedin", href: "https://linkedin.com" },
];



---

<Layout title="Contact Us | RYTON LIMITED">
  <!-- 1. Enhanced Hero Section -->
  <section class="relative bg-linear-to-br from-blue-50 to-slate-100 py-20 sm:py-28 overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-10 left-10 w-20 h-20 bg-blue-500 rounded-full blur-xl"></div>
      <div class="absolute bottom-10 right-10 w-32 h-32 bg-slate-500 rounded-full blur-xl"></div>
    </div>
    
    <div class="container mx-auto max-w-4xl px-4 relative z-10">
      <div class="text-center" data-aos="fade-up">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl bg-linear-to-r from-blue-600 to-slate-800 bg-clip-text text-transparent">
          Get in Touch
        </h1>
        <p class="mt-6 text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
          We're here to help. Whether you have a question about our products or want to discuss a partnership, we look forward to hearing from you.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Enhanced Main Content Grid -->
  <section class="bg-white py-16 sm:py-24">
    <div class="container mx-auto grid grid-cols-1 gap-12 px-4 lg:grid-cols-5 lg:gap-16">
      
      <!-- Left Column: Enhanced Contact Details -->
      <div class="space-y-8 lg:col-span-2">
        {contactDetails.map((detail, index) => (
          <div 
            class="group flex items-start space-x-5 p-6 rounded-2xl transition-all duration-300 hover:bg-blue-50 hover:shadow-md border border-transparent hover:border-blue-100"
            data-aos="fade-right"
            data-aos-delay={index * 100}
          >
            <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-linear-to-br from-blue-500 to-blue-600 text-white shadow-lg group-hover:scale-105 transition-transform duration-300">
              <span class="text-2xl" role="img" aria-label={detail.title}>{detail.icon}</span>
            </div>
            <div class="flex-1">
              <h3 class="text-xl font-bold text-slate-900">{detail.title}</h3>
              {detail.lines.map((line, lineIndex) => (
                <p class="mt-1 text-slate-600">{line}</p>
              ))}
              {detail.link && (
                <a 
                  href={detail.link.href} 
                  class="mt-3 inline-flex items-center font-semibold text-blue-600 transition-all duration-300 hover:text-blue-800 hover:gap-2 gap-1 group/link"
                  aria-label={detail.link.ariaLabel}
                >
                  {detail.link.text}
                  <span class="text-lg transition-transform duration-300 group-hover/link:translate-x-1">→</span>
                </a>
              )}
              {detail.note && (
                <p class="mt-2 text-sm text-slate-500 italic">{detail.note}</p>
              )}
            </div>
          </div>
        ))}

        <!-- Social Links -->
        <div class="pt-6" data-aos="fade-right" data-aos-delay="400">
          <h4 class="text-lg font-semibold text-slate-900 mb-4">Follow Us</h4>
          <div class="flex space-x-4">
            {socialLinks.map(({ name, icon, href }) => (
              <a 
                href={href}
                class="flex items-center justify-center w-12 h-12 rounded-xl bg-slate-100 text-slate-600 hover:bg-blue-100 hover:text-blue-600 transition-all duration-300 hover:scale-110 hover:shadow-md"
                aria-label={`Follow us on ${name}`}
                
              >
                <i class={icon} aria-hidden="true"></i>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column: Enhanced Contact Form -->
      <div 
        class="rounded-3xl bg-linear-to-br from-white to-blue-50 p-8 shadow-xl border border-blue-100 lg:col-span-3"
        data-aos="fade-left"
        data-aos-delay="200"
      >
        <div class="text-center mb-8">
          <h2 class="text-3xl font-bold sm:text-4xl bg-linear-to-r from-blue-600 to-slate-800 bg-clip-text text-transparent">
            Send Us a Message
          </h2>
          <p class="mt-3 text-slate-600">
            Fill out the form below and we'll get back to you as soon as possible.
          </p>
        </div>
        
        <form 
          name="contact" 
          method="POST" 
          data-netlify="true" 
          class="space-y-6"
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>Don't fill this out if you're human: <input name="bot-field" /></label>
          </p>
          
          <!-- Full Name -->
          <div>
            <label for="name" class="block text-sm font-semibold text-slate-700 mb-2">
              Full Name *
            </label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required 
              class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all duration-200 outline-none"
              placeholder="Enter your full name"
            />
          </div>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <!-- Company Name -->
            <div>
              <label for="company" class="block text-sm font-semibold text-slate-700 mb-2">
                Company Name
              </label>
              <input 
                type="text" 
                id="company" 
                name="company" 
                class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all duration-200 outline-none"
                placeholder="Your company"
              />
            </div>

            <!-- Email -->
            <div>
              <label for="email" class="block text-sm font-semibold text-slate-700 mb-2">
                Email Address *
              </label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all duration-200 outline-none"
                placeholder="your.email@example.com"
              />
            </div>
          </div>

          <!-- Message -->
          <div>
            <label for="message" class="block text-sm font-semibold text-slate-700 mb-2">
              Your Message *
            </label>
            <textarea 
              id="message" 
              name="message" 
              rows="5" 
              required 
              class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all duration-200 outline-none resize-vertical"
              placeholder="Tell us how we can help you..."
            ></textarea>
          </div>

          <!-- Submit Button -->
          <div>
            <button 
              type="submit" 
              class="w-full inline-flex items-center justify-center px-8 py-4 font-bold text-white bg-linear-to-r from-blue-600 to-blue-700 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1 active:scale-95 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 group"
            >
              <span class="group-hover:scale-110 transition-transform duration-200 mr-2">
                ✉️
              </span>
              Send Message
            </button>
          </div>
        </form>
        
        <p class="mt-6 text-center text-sm text-slate-500">
          This form is protected by reCAPTCHA and the Google 
          <a href="https://policies.google.com/privacy" class="text-blue-600 hover:text-blue-800 underline"> Privacy Policy</a> and
          <a href="https://policies.google.com/terms" class="text-blue-600 hover:text-blue-800 underline"> Terms of Service</a> apply.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. Enhanced Map Section -->
  <div class="relative bg-slate-50 py-16">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12" data-aos="fade-up">
        <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">Find Our Office</h2>
        <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto">
          Visit us at our registered office in Unit A, 3rd Floor, Belmont Road, Uxbridge, England, UB8 1HE. We're always happy to welcome visitors by appointment.
        </p>
      </div>
      
      <div 
        class="rounded-3xl overflow-hidden shadow-2xl border border-slate-200 h-96 w-full"
        data-aos="zoom-in"
        data-aos-delay="200"
      >
      
        <iframe
          class="h-full w-full"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2481.045683699779!2d-0.4783565247229332!3d51.54906130766068!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x48766e791acf7c87%3A0x3d1b1729fd943cde!2sBelmont%20Rd%2C%20Uxbridge%2C%20UK!5e0!3m2!1sen!2sbd!4v1777344339960!5m2!1sen!2sbd" 
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Location of RYTON LIMITED - 3rd Floor Belmont Road, Uxbridge, England, UB8 1HE"
        >
        </iframe>
       </div>
      
      <!-- Map Call to Action -->
      <div class="text-center mt-8" data-aos="fade-up" data-aos-delay="400">
        <a 
          href="https://maps.app.goo.gl/QEBgeH7WamtzHBXM9"
          class="inline-flex items-center px-6 py-3 font-semibold text-blue-600 bg-white border border-blue-200 rounded-xl hover:bg-blue-50 hover:shadow-md transition-all duration-300"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="mr-2">🗺️</span>
          Get Directions
          <span class="ml-2 text-lg">→</span>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Enhanced animation classes */
  [data-aos] { 
    opacity: 0; 
    transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94); 
  }
  
  [data-aos="fade-up"] { 
    transform: translateY(3rem); 
  }
  
  [data-aos="fade-right"] { 
    transform: translateX(-3rem); 
  }
  
  [data-aos="fade-left"] { 
    transform: translateX(3rem); 
  }
  
  [data-aos="zoom-in"] { 
    transform: scale(0.9); 
  }
  
  [data-aos].is-visible { 
    opacity: 1; 
    transform: translate(0) scale(1); 
  }

  /* Custom scrollbar for textarea */
  textarea::-webkit-scrollbar {
    width: 6px;
  }

  textarea::-webkit-scrollbar-track {
    background: #f1f5f9;
    border-radius: 3px;
  }

  textarea::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 3px;
  }

  textarea::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }
</style>

<script>
  // Enhanced animation script with better performance and TypeScript fixes
  if (typeof window !== 'undefined') {
    let observer: IntersectionObserver | undefined;
    
    const initAnimations = () => {
      const animatedElements = document.querySelectorAll('[data-aos]');
      
      observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const delay = entry.target.getAttribute('data-aos-delay') || '0';
            setTimeout(() => {
              entry.target.classList.add('is-visible');
            }, parseInt(delay));
            observer?.unobserve(entry.target);
          }
        });
      }, { 
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      });
      
      animatedElements.forEach(el => observer?.observe(el));
    };

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAnimations);
    } else {
      initAnimations();
    }

    // Add form interaction enhancements
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.querySelector('form[name="contact"]');
      if (form) {
        form.addEventListener('submit', (e) => {
          const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
          if (submitBtn) {
            submitBtn.innerHTML = 'Sending...';
            submitBtn.disabled = true;
          }
        });
      }
    });
  }
</script>