---
// File: src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="RYTON LIMITED | Premium Wholesale Distributor" description="RYTON LIMITED - Your trusted wholesale distributor for premium quality personal care products, beverages, and more. Serving businesses across the UK.">
  
  <!-- Hero Section with Animation -->
  <section class="relative min-h-screen flex items-center justify-center bg-gray-900 text-white overflow-hidden">
    <!-- Animated Background -->
    <div class="absolute inset-0">
      <!-- Gradient Background -->
      <div class="absolute inset-0 bg-linear-to-br from-blue-900 via-blue-800 to-indigo-900"></div>
      
      <!-- Animated Particles -->
      <div class="absolute inset-0 opacity-30">
        <div class="particles-container"></div>
      </div>
      
      <!-- Geometric Shapes -->
      <div class="absolute top-0 left-0 w-72 h-72 bg-blue-600 rounded-full mix-blend-multiply filter blur-xl opacity-20 animate-pulse"></div>
      <div class="absolute bottom-0 right-0 w-96 h-96 bg-indigo-700 rounded-full mix-blend-multiply filter blur-xl opacity-30 animate-pulse animation-delay-2000"></div>
      <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-cyan-500 rounded-full mix-blend-multiply filter blur-2xl opacity-10"></div>
    </div>
    
    <!-- Content -->
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Text Content -->
        <div class="space-y-8 animate-fade-in-up">
          <!-- Trust Badge -->
          <div class="inline-flex items-center bg-white/10 backdrop-blur-md rounded-full px-6 py-3 border border-white/20">
            <span class="w-3 h-3 bg-green-400 rounded-full mr-3 animate-pulse"></span>
            <span class="text-sm font-medium">Trusted by 500+ Businesses Nationwide</span>
          </div>
          
          <!-- Main Heading -->
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-black leading-tight">
            Premium
            <span class="block text-transparent bg-clip-text bg-linear-to-r from-cyan-300 to-blue-300 mt-2">
              Wholesale
            </span>
            Solutions
          </h1>
          
          <!-- Subheading -->
          <p class="text-xl md:text-2xl opacity-90 leading-relaxed font-light">
            Your trusted partner for 
            <span class="text-cyan-300 font-semibold">quality products</span> 
            and 
            <span class="text-blue-300 font-semibold">reliable distribution</span>
            across the UK
          </p>
          
          <!-- Description -->
          <p class="text-lg opacity-80 leading-relaxed max-w-xl">
            Supplying businesses with premium personal care, beverages, and consumer goods at competitive wholesale prices with next-day delivery available.
          </p>
          
          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row gap-6 pt-4">
            <a 
              href="#products" 
              class="group bg-linear-to-r from-cyan-500 to-blue-600 text-white px-8 py-4 rounded-xl font-bold hover:from-cyan-600 hover:to-blue-700 transition-all duration-300 transform hover:scale-105 text-center shadow-2xl hover:shadow-3xl flex items-center justify-center min-w-[200px]"
            >
              <span>Explore Products</span>
              <i class="fas fa-arrow-right ml-3 transform group-hover:translate-x-1 transition-transform duration-300"></i>
            </a>
            
            <a 
              href="#contact" 
              class="group bg-transparent border-2 border-white text-white px-8 py-4 rounded-xl font-bold hover:bg-white hover:bg-opacity-10 transition-all duration-300 transform hover:scale-105 text-center backdrop-blur-sm flex items-center justify-center min-w-[200px]"
            >
              <span>Become a Partner</span>
              <i class="fas fa-handshake ml-3 transform group-hover:scale-110 transition-transform duration-300"></i>
            </a>
          </div>
          
          <!-- Trust Indicators -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-8">
            <div class="flex items-center text-sm opacity-80">
              <i class="fas fa-check-circle text-green-400 mr-2"></i>
              <span>Premium Quality</span>
            </div>
            <div class="flex items-center text-sm opacity-80">
              <i class="fas fa-shipping-fast text-blue-300 mr-2"></i>
              <span>Next-Day Delivery</span>
            </div>
            <div class="flex items-center text-sm opacity-80">
              <i class="fas fa-pound-sign text-amber-300 mr-2"></i>
              <span>Best Prices</span>
            </div>
          </div>
        </div>
        
        <!-- Visual Element -->
        <div class="relative animate-fade-in-up animation-delay-300">
          <!-- Floating Product Cards -->
          <div class="relative h-96">
            <!-- Card 1 -->
            <div class="absolute top-0 left-0 w-64 h-80 bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/20 shadow-2xl transform rotate-6 hover:rotate-0 transition-transform duration-500">
              <div class="bg-linear-to-br from-blue-500 to-cyan-400 w-full h-32 rounded-xl mb-4 flex items-center justify-center">
                <i class="fas fa-pump-soap text-5xl text-white"></i>
              </div>
              <h3 class="text-xl font-bold text-white mb-2">Personal Care</h3>
              <p class="text-white/80 text-sm">Premium skincare & hygiene products</p>
            </div>
            
            <!-- Card 2 -->
            <div class="absolute bottom-0 right-0 w-64 h-80 bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/20 shadow-2xl transform -rotate-6 hover:rotate-0 transition-transform duration-500">
              <div class="bg-linear-to-br from-green-500 to-emerald-400 w-full h-32 rounded-xl mb-4 flex items-center justify-center">
                <i class="fas fa-wine-bottle text-5xl text-white"></i>
              </div>
              <h3 class="text-xl font-bold text-white mb-2">Beverages</h3>
              <p class="text-white/80 text-sm">Quality drinks for retail & hospitality</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
      <a href="#products" class="text-white text-2xl hover:text-cyan-300 transition-colors duration-300">
        <i class="fas fa-chevron-down"></i>
      </a>
    </div>
    
    <!-- Wave Divider -->
    <div class="absolute bottom-0 left-0 w-full">
      <svg class="w-full h-16 md:h-24 text-white" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z" opacity=".25" class="fill-current"></path>
        <path d="M0,0V15.81C13,36.92,27.64,56.86,47.69,72.05,99.41,111.27,165,111,224.58,91.58c31.15-10.15,60.09-26.07,89.67-39.8,40.92-19,84.73-46,130.83-49.67,36.26-2.85,70.9,9.42,98.6,31.56,31.77,25.39,62.32,62,103.63,73,40.44,10.79,81.35-6.69,119.13-24.28s75.16-39,116.92-43.05c59.73-5.85,113.28,22.88,168.9,38.84,30.2,8.66,59,6.17,87.09-7.5,22.43-10.89,48-26.93,60.65-49.24V0Z" opacity=".5" class="fill-current"></path>
        <path d="M0,0V5.63C149.93,59,314.09,71.32,475.83,42.57c43-7.64,84.23-20.12,127.61-26.46,59-8.63,112.48,12.24,165.56,35.4C827.93,77.22,886,95.24,951.2,90c86.53-7,172.46-45.71,248.8-84.81V0Z" class="fill-current"></path>
      </svg>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="text-center animate-fade-in-up animation-delay-200">
          <div class="text-3xl md:text-4xl font-bold text-blue-800 mb-2 count-up" data-target="500">0</div>
          <div class="text-gray-600">Active Partners</div>
        </div>
        <div class="text-center animate-fade-in-up animation-delay-400">
          <div class="text-3xl md:text-4xl font-bold text-blue-800 mb-2 count-up" data-target="1000">0</div>
          <div class="text-gray-600">Products</div>
        </div>
        <div class="text-center animate-fade-in-up animation-delay-600">
          <div class="text-3xl md:text-4xl font-bold text-blue-800 mb-2 count-up" data-target="15">0</div>
          <div class="text-gray-600">Years Experience</div>
        </div>
        <div class="text-center animate-fade-in-up animation-delay-800">
          <div class="text-3xl md:text-4xl font-bold text-blue-800 mb-2 count-up" data-target="98">0</div>
          <div class="text-gray-600">% Satisfaction</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Categories -->
  <section id="products" class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-800 mb-4 animate-fade-in-up">Our Product Categories</h2>
        <p class="text-gray-600 max-w-2xl mx-auto text-lg animate-fade-in-up animation-delay-200">
          We specialize in premium quality products across multiple categories to meet all your business needs.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Personal Care -->
        <div class="group bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 animate-fade-in-up">
          <div class="h-48 bg-linear-to-r from-blue-500 to-blue-400 flex items-center justify-center relative overflow-hidden">
            <i class="fas fa-pump-soap text-6xl text-white transform group-hover:scale-110 transition-transform duration-500"></i>
            <div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-800 mb-3">Personal Care</h3>
            <p class="text-gray-600 mb-4">Premium skincare, haircare, hygiene products and cosmetics from trusted brands.</p>
            <a href="#" class="text-blue-700 font-medium hover:text-blue-800 inline-flex items-center group/link">
              Explore Products <i class="fas fa-arrow-right ml-2 transform group-hover/link:translate-x-1 transition-transform duration-300"></i>
            </a>
          </div>
        </div>
        
        <!-- Beverages -->
        <div class="group bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 animate-fade-in-up animation-delay-200">
          <div class="h-48 bg-linear-to-r from-green-500 to-green-400 flex items-center justify-center relative overflow-hidden">
            <i class="fas fa-wine-bottle text-6xl text-white transform group-hover:scale-110 transition-transform duration-500"></i>
            <div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-800 mb-3">Beverages</h3>
            <p class="text-gray-600 mb-4">Quality soft drinks, juices, water, and specialty beverages for retail and hospitality.</p>
            <a href="#" class="text-blue-700 font-medium hover:text-blue-800 inline-flex items-center group/link">
              Explore Products <i class="fas fa-arrow-right ml-2 transform group-hover/link:translate-x-1 transition-transform duration-300"></i>
            </a>
          </div>
        </div>
        
        <!-- Household Goods -->
        <div class="group bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 animate-fade-in-up animation-delay-400">
          <div class="h-48 bg-linear-to-r from-amber-500 to-amber-400 flex items-center justify-center relative overflow-hidden">
            <i class="fas fa-home text-6xl text-white transform group-hover:scale-110 transition-transform duration-500"></i>
            <div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-800 mb-3">Household Goods</h3>
            <p class="text-gray-600 mb-4">Cleaning supplies, home essentials, and everyday necessities for modern living.</p>
            <a href="#" class="text-blue-700 font-medium hover:text-blue-800 inline-flex items-center group/link">
              Explore Products <i class="fas fa-arrow-right ml-2 transform group-hover/link:translate-x-1 transition-transform duration-300"></i>
            </a>
          </div>
        </div>

        <!-- NEW: Confectionery & Snacks -->
        <div class="group bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 animate-fade-in-up">
          <div class="h-48 bg-linear-to-r from-red-500 to-red-400 flex items-center justify-center relative overflow-hidden">
            <i class="fas fa-cookie text-6xl text-white transform group-hover:scale-110 transition-transform duration-500"></i>
            <div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-800 mb-3">Confectionery & Snacks</h3>
            <p class="text-gray-600 mb-4">Sweet treats, chocolates, biscuits, and savory snacks for all retail environments.</p>
            <a href="#" class="text-blue-700 font-medium hover:text-blue-800 inline-flex items-center group/link">
              Explore Products <i class="fas fa-arrow-right ml-2 transform group-hover/link:translate-x-1 transition-transform duration-300"></i>
            </a>
          </div>
        </div>

        <!-- NEW: Health & Wellness -->
        <div class="group bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 animate-fade-in-up animation-delay-200">
          <div class="h-48 bg-linear-to-r from-emerald-500 to-emerald-400 flex items-center justify-center relative overflow-hidden">
            <i class="fas fa-heartbeat text-6xl text-white transform group-hover:scale-110 transition-transform duration-500"></i>
            <div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-800 mb-3">Health & Wellness</h3>
            <p class="text-gray-600 mb-4">Vitamins, supplements, health foods, and wellness products for conscious consumers.</p>
            <a href="#" class="text-blue-700 font-medium hover:text-blue-800 inline-flex items-center group/link">
              Explore Products <i class="fas fa-arrow-right ml-2 transform group-hover/link:translate-x-1 transition-transform duration-300"></i>
            </a>
          </div>
        </div>

        <!-- NEW: Baby & Child Care -->
        <div class="group bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 animate-fade-in-up animation-delay-400">
          <div class="h-48 bg-linear-to-r from-pink-500 to-pink-400 flex items-center justify-center relative overflow-hidden">
            <i class="fas fa-baby text-6xl text-white transform group-hover:scale-110 transition-transform duration-500"></i>
            <div class="absolute inset-0 bg-black opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-800 mb-3">Baby & Child Care</h3>
            <p class="text-gray-600 mb-4">Safe, gentle products for babies and children including toiletries, food, and accessories.</p>
            <a href="#" class="text-blue-700 font-medium hover:text-blue-800 inline-flex items-center group/link">
              Explore Products <i class="fas fa-arrow-right ml-2 transform group-hover/link:translate-x-1 transition-transform duration-300"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-800 mb-4 animate-fade-in-up">Why Choose RYTON LIMITED</h2>
        <p class="text-gray-600 max-w-2xl mx-auto text-lg animate-fade-in-up animation-delay-200">
          We're committed to being more than just a supplier - we're your strategic business partner.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center p-6 group animate-fade-in-up">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-blue-200 transition-colors duration-300">
            <i class="fas fa-award text-3xl text-blue-700 transform group-hover:scale-110 transition-transform duration-300"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-3">Premium Quality</h3>
          <p class="text-gray-600">We source only the highest quality products from reputable manufacturers and brands.</p>
        </div>
        
        <div class="text-center p-6 group animate-fade-in-up animation-delay-200">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-blue-200 transition-colors duration-300">
            <i class="fas fa-truck text-3xl text-blue-700 transform group-hover:scale-110 transition-transform duration-300"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-3">Reliable Delivery</h3>
          <p class="text-gray-600">Efficient logistics and reliable delivery schedules to keep your business running smoothly.</p>
        </div>
        
        <div class="text-center p-6 group animate-fade-in-up animation-delay-400">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-blue-200 transition-colors duration-300">
            <i class="fas fa-handshake text-3xl text-blue-700 transform group-hover:scale-110 transition-transform duration-300"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-3">Partnership Approach</h3>
          <p class="text-gray-600">We work closely with our clients to understand their needs and provide tailored solutions.</p>
        </div>
        
        <div class="text-center p-6 group animate-fade-in-up animation-delay-600">
          <div class="bg-blue-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-blue-200 transition-colors duration-300">
            <i class="fas fa-pound-sign text-3xl text-blue-700 transform group-hover:scale-110 transition-transform duration-300"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-3">Competitive Pricing</h3>
          <p class="text-gray-600">Get the best value with our competitive wholesale pricing and volume discounts.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Brands/Partners Carousel -->
  <!-- Enhanced Brands Section -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4">Trusted by Industry Leaders</h2>
        <p class="text-gray-600 max-w-2xl mx-auto text-lg">
          We partner with renowned brands to bring you the highest quality products
        </p>
      </div>
      
      <!-- Brands Carousel -->
      <div class="relative overflow-hidden py-8">
        <!-- Gradient Fades -->
        <div class="absolute left-0 top-0 bottom-0 w-20 bg-linear-to-r from-gray-50 to-transparent z-10"></div>
        <div class="absolute right-0 top-0 bottom-0 w-20 bg-linear-to-l from-gray-50 to-transparent z-10"></div>
        
        <!-- Carousel Container -->
        <div class="flex space-x-8 animate-scroll">
          <!-- Brand Items -->
          <div class="shrink-0 flex space-x-8 pr-8">
            <!-- Brand 1 -->
            <div class="group bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-500 transform hover:-translate-y-2 w-48 h-32 flex items-center justify-center p-6 border border-gray-100">
              <img src="/brand/1.svg" alt="Brand 1" class="max-w-full max-h-16 opacity-70 group-hover:opacity-100 transition-opacity duration-300 filter grayscale group-hover:grayscale-0">
            </div>
            
            <!-- Brand 2 -->
            <div class="group bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-500 transform hover:-translate-y-2 w-48 h-32 flex items-center justify-center p-6 border border-gray-100">
              <img src="/brand/2.svg" alt="Brand 2" class="max-w-full max-h-16 opacity-70 group-hover:opacity-100 transition-opacity duration-300 filter grayscale group-hover:grayscale-0">
            </div>
            
            <!-- Brand 3 -->
            <div class="group bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-500 transform hover:-translate-y-2 w-48 h-32 flex items-center justify-center p-6 border border-gray-100">
              <img src="/brand/3.svg" alt="Brand 3" class="max-w-full max-h-16 opacity-70 group-hover:opacity-100 transition-opacity duration-300 filter grayscale group-hover:grayscale-0">
            </div>
            
            <!-- Brand 4 -->
            <div class="group bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-500 transform hover:-translate-y-2 w-48 h-32 flex items-center justify-center p-6 border border-gray-100">
              <img src="/brand/4.svg" alt="Brand 4" class="max-w-full max-h-16 opacity-70 group-hover:opacity-100 transition-opacity duration-300 filter grayscale group-hover:grayscale-0">
            </div>
            
            <!-- Brand 5 -->
            <div class="group bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-500 transform hover:-translate-y-2 w-48 h-32 flex items-center justify-center p-6 border border-gray-100">
              <img src="/brand/5.svg" alt="Brand 5" class="max-w-full max-h-16 opacity-70 group-hover:opacity-100 transition-opacity duration-300 filter grayscale group-hover:grayscale-0">
            </div>
            
            <!-- Brand 6 -->
            <div class="group bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-500 transform hover:-translate-y-2 w-48 h-32 flex items-center justify-center p-6 border border-gray-100">
              <img src="/brand/6.svg" alt="Brand 6" class="max-w-full max-h-16 opacity-70 group-hover:opacity-100 transition-opacity duration-300 filter grayscale group-hover:grayscale-0">
            </div>
            
            <!-- Brand 7 -->
            <div class="group bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-500 transform hover:-translate-y-2 w-48 h-32 flex items-center justify-center p-6 border border-gray-100">
              <img src="/brand/7.svg" alt="Brand 7" class="max-w-full max-h-16 opacity-70 group-hover:opacity-100 transition-opacity duration-300 filter grayscale group-hover:grayscale-0">
            </div>
            
            <!-- Brand 8 -->
            <div class="group bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-500 transform hover:-translate-y-2 w-48 h-32 flex items-center justify-center p-6 border border-gray-100">
              <img src="/brand/8.svg" alt="Brand 8" class="max-w-full max-h-16 opacity-70 group-hover:opacity-100 transition-opacity duration-300 filter grayscale group-hover:grayscale-0">
            </div>
            
            <!-- Brand 9 -->
            <div class="group bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-500 transform hover:-translate-y-2 w-48 h-32 flex items-center justify-center p-6 border border-gray-100">
              <img src="/brand/9.svg" alt="Brand 9" class="max-w-full max-h-16 opacity-70 group-hover:opacity-100 transition-opacity duration-300 filter grayscale group-hover:grayscale-0">
            </div>
            
            <!-- Brand 10 -->
            <div class="group bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-500 transform hover:-translate-y-2 w-48 h-32 flex items-center justify-center p-6 border border-gray-100">
              <img src="/brand/10.svg" alt="Brand 10" class="max-w-full max-h-16 opacity-70 group-hover:opacity-100 transition-opacity duration-300 filter grayscale group-hover:grayscale-0">
            </div>
          </div>
          
          <!-- Duplicate for seamless loop -->
