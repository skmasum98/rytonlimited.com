---
import Layout from '../layouts/Layout.astro';

const values = [
  { icon: "⭐", title: "Uncompromising Quality", description: "We source and supply only products that we would be proud to use in our own homes, ensuring excellence in every item." },
  { icon: "🤝", title: "True Partnership", description: "We believe in collaborative success. Your growth is our growth, and we are dedicated to providing the support you need." },
  { icon: "🚚", title: "Dependable Service", description: "From streamlined ordering to reliable, on-time delivery, we are committed to making your experience seamless and efficient." },
  { icon: "💡", title: "Continuous Improvement", description: "We constantly adapt to market trends and listen to client feedback to ensure our product range is always relevant and competitive." },
];
---

<Layout title="About Us | RYTON LIMITED">
  <!-- 1. Hero Section -->
  <section class="relative overflow-hidden bg-linear-to-b from-blue-50 to-white py-24 text-center sm:py-32">
    <div class="container mx-auto max-w-5xl px-4 relative z-10">
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl md:text-6xl animate-fadeIn">
        Building the Future of Wholesale, Together.
      </h1>
      <p class="mt-6 text-lg text-slate-600 leading-relaxed animate-fadeIn delay-200">
        RYTON LIMITED is more than a supplier; we are your strategic partner in growth, committed to providing exceptional products and unparalleled service.
      </p>
    </div>
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/white-wall.png')] opacity-20"></div>
  </section>

  <!-- 2. Our Story Section -->
  <section class="bg-white py-24 sm:py-32">
    <div class="container mx-auto grid grid-cols-1 items-center gap-14 px-4 lg:grid-cols-2">
      <div class="aos-item">
        <div class="relative">
          <img 
            src="/15.jpg" 
            alt="RYTON LIMITED warehouse operations" 
            class="rounded-3xl shadow-2xl border border-slate-100"
            loading="lazy"
          />
          <div class="absolute inset-0 rounded-3xl ring-1 ring-inset ring-white/20"></div>
        </div>
      </div>
      <div class="aos-item" data-aos-delay="100">
        <span class="inline-block rounded-full bg-blue-100/70 px-4 py-1.5 text-sm font-semibold text-blue-700">
          Our Story
        </span>
        <h2 class="mt-5 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          From a Simple Idea to a Trusted Partner
        </h2>
        <p class="mt-6 text-slate-600 leading-relaxed">
          Founded on the principle of bridging the gap between quality manufacturers and discerning retailers, RYTON LIMITED started with a simple mission: to make high-quality household goods accessible to businesses of all sizes.
        </p>
        <p class="mt-4 text-slate-600 leading-relaxed">
          Today, we have grown into a leading wholesale provider in the UK, but our core values remain unchanged. Our success is built on the strong, lasting relationships we forge with our clients.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. Our Values Section -->
  <section class="bg-slate-50 py-24 sm:py-32">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          The Principles That Guide Us
        </h2>
        <p class="mt-4 text-lg text-slate-600">
          Our commitment to these core values ensures we deliver excellence in every aspect of our business.
        </p>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {values.map((value, index) => (
          <div 
            class="aos-item group rounded-3xl bg-white p-8 text-center shadow-md border border-slate-100 transition-all duration-500 hover:-translate-y-2 hover:shadow-xl hover:border-blue-200"
            data-aos-delay={index * 100}
          >
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-linear-to-br from-blue-100 to-blue-200 shadow-inner transition-all duration-500 group-hover:scale-110">
              <span class="text-3xl">{value.icon}</span>
            </div>
            <h3 class="mt-6 text-xl font-semibold text-slate-900">{value.title}</h3>
            <p class="mt-3 text-slate-600 leading-relaxed">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- 4. CTA Section -->
  <section class="relative bg-linear-to-br from-blue-800 to-blue-900 text-white">
    <div class="absolute inset-0 bg-[url('/16.jpg')] opacity-20 bg-cover"></div>
    <div class="relative container mx-auto px-4 py-24 text-center sm:py-32">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Let's Work Together
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-blue-100 leading-relaxed">
        Discover how our products and services can benefit your business. Explore our catalog or get in touch with our team today.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/products" class="inline-block w-full sm:w-auto rounded-lg bg-green-600 px-8 py-3 font-semibold text-white shadow-lg transition-all duration-300 hover:bg-green-700 hover:-translate-y-1">
          View Our Products
        </a>
        <a href="/contact" class="inline-block w-full sm:w-auto rounded-lg bg-white px-8 py-3 font-semibold text-blue-700 shadow-lg transition-all duration-300 hover:bg-slate-100 hover:-translate-y-1">
          Contact Our Team
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Fade-in animation for hero */
  @keyframes fadeIn {
    0% { opacity: 0; transform: translateY(1rem); }
    100% { opacity: 1; transform: translateY(0); }
  }
  .animate-fadeIn {
    animation: fadeIn 1s ease-out forwards;
  }
  .delay-200 { animation-delay: 0.2s; }

  /* Scroll-based reveal (AOS imitation) */
  .aos-item {
    opacity: 0;
    transform: translateY(2rem);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .aos-item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  if (typeof window !== 'undefined') {
    const elements = document.querySelectorAll('.aos-item');
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    elements.forEach(el => observer.observe(el));
  }
</script>
